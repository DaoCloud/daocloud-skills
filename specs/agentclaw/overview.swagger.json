          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/overviewGetRunningStateResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "rangeQuery.start",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "rangeQuery.end",
            "description": "end unix timestamp .e.g. 1697597347\ndefault now",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "rangeQuery.step",
            "description": "step time step in seconds; if unset, server calculates it from start and end.",
            "in": "query",
            "required": false,
            "type": "number",
            "format": "double"
          }
        ],
        "tags": [
          "OverviewService"
        ]
      }
    },
